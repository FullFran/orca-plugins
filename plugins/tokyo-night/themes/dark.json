{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#1a1b26",
    "--foreground": "#c0caf5",
    "--editor-surface": "#1a1b26",
    "--card": "#1f2335",
    "--card-foreground": "#c0caf5",
    "--popover": "#1f2335",
    "--popover-foreground": "#c0caf5",
    "--primary": "#7aa2f7",
    "--primary-foreground": "#1a1b26",
    "--secondary": "#292e42",
    "--secondary-foreground": "#c0caf5",
    "--muted": "#292e42",
    "--muted-foreground": "#a9b1d6",
    "--accent": "#292e42",
    "--accent-foreground": "#c0caf5",
    "--border": "#3b4261",
    "--input": "#3b4261",
    "--ring": "#7aa2f7",
    "--chart-1": "#7aa2f7",
    "--chart-2": "#bb9af7",
    "--chart-3": "#9ece6a",
    "--chart-4": "#e0af68",
    "--chart-5": "#7dcfff",
    "--sidebar": "#16161e",
    "--sidebar-foreground": "#c0caf5",
    "--sidebar-primary": "#7aa2f7",
    "--sidebar-primary-foreground": "#16161e",
    "--sidebar-accent": "#292e42",
    "--sidebar-accent-foreground": "#c0caf5",
    "--sidebar-border": "#292e42",
    "--sidebar-ring": "#7aa2f7",
    "--worktree-sidebar": "#16161e",
    "--worktree-sidebar-foreground": "#c0caf5",
    "--worktree-sidebar-accent": "#292e42",
    "--worktree-sidebar-accent-foreground": "#c0caf5",
    "--worktree-sidebar-border": "#292e42",
    "--worktree-sidebar-ring": "#7aa2f7",
    "--worktree-sidebar-active": "#292e42",
    "--worktree-sidebar-active-border": "#7aa2f7",
    "--host-badge": "#292e42",
    "--host-badge-foreground": "#a9b1d6",
    "--tab-bar": "#16161e",
    "--tab-active": "#1a1b26",
    "--tab-active-foreground": "#c0caf5",
    "--tab-active-indicator": "#7aa2f7",
    "--tab-inactive": "#16161e",
    "--tab-inactive-foreground": "#9aa5ce",
    "--split-divider": "#3b4261",
    "--split-divider-hover": "#7aa2f7",
    "--chat-user-message": "#292e42",
    "--text-link": "#7dcfff",
    "--diff-added": "#9ece6a",
    "--diff-removed": "#f7768e",
    "--git-decoration-added": "#9ece6a",
    "--git-decoration-modified": "#e0af68",
    "--git-decoration-deleted": "#f7768e",
    "--git-decoration-renamed": "#7dcfff",
    "--git-decoration-untracked": "#73daca",
    "--git-decoration-copied": "#bb9af7",
    "--git-decoration-ignored": "#737aa2"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#7a82ad", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "keyword.control"], "settings": { "foreground": "#bb9af7" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#89ddff" } },
    { "scope": ["string", "markup.inline.raw"], "settings": { "foreground": "#9ece6a" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#ff9e64" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#7aa2f7" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#2ac3de" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#c0caf5" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#e0af68" } },
    { "scope": ["variable.other.property", "support.variable.property"], "settings": { "foreground": "#73daca" } },
    { "scope": ["entity.name.tag", "support.type.property-name"], "settings": { "foreground": "#f7768e" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#bb9af7" } },
    { "scope": "punctuation", "settings": { "foreground": "#89ddff" } },
    { "scope": "markup.heading", "settings": { "foreground": "#7aa2f7", "fontStyle": "bold" } },
    { "scope": "markup.underline.link", "settings": { "foreground": "#73daca" } },
    { "scope": "invalid", "settings": { "foreground": "#ff007c" } }
  ]
}
